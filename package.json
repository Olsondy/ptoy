{
  "name": "ptoy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "app": "node scripts/app.mjs",
    "dev:web": "pnpm --filter @ptoy/web dev",
    "dev:agent": "pnpm --filter @ptoy/agent dev",
    "dev:token": "pnpm --filter @ptoy/agent dev:token",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:e2e": "pnpm --filter @ptoy/e2e test:e2e"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
