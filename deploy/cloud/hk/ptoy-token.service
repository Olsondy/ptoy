[Unit]
Description=ptoy HK token and invitation service
After=network-online.target livekit-server.service
Wants=network-online.target livekit-server.service

[Service]
Type=simple
User=ptoy
Group=ptoy
Environment=HOME=/var/lib/ptoy
Environment=XDG_CACHE_HOME=/var/cache/ptoy
WorkingDirectory=/opt/ptoy/source/apps/agent
ExecStart=/usr/local/bin/node /opt/ptoy/source/scripts/run-agent.mjs start:token --env hk
Restart=on-failure
RestartSec=5
TimeoutStopSec=infinity
SendSIGKILL=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ptoy /var/cache/ptoy

[Install]
WantedBy=multi-user.target
