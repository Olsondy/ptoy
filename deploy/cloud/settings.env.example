# Copy outside the repository; never put production credentials in Git.
# Unquoted KEY=value only. No shell evaluation, interpolation or inline comments.
APP_DOMAIN=voice.example.com
RTC_DOMAIN=rtc.example.com
PUBLIC_IPV4=203.0.113.10
# Windows Tailscale IPv4 (100.64.0.0/10) or full *.ts.net MagicDNS name.
MODEL_HOST=100.100.100.100
ASR_PORT=8001
LLM_PORT=8080
TTS_PORT=8002
LLM_MODEL=qwen3-8b
# Match the model service configuration. This is not a public API credential.
LLM_API_KEY=no-key
DEFAULT_CHARACTER=xiaoyou
# Absolute executables installed by the operator; no automatic downloads.
NODE_BIN=/usr/bin/node
PNPM_BIN=/usr/local/bin/pnpm
LIVEKIT_BIN=/usr/local/bin/livekit-server
# Exact installed version as printed by livekit-server --version, e.g. 1.x.y.
# This example deliberately requires replacement.
LIVEKIT_VERSION=REPLACE_WITH_INSTALLED_VERSION
