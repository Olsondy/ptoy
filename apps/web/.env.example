# Token server the Vite dev/preview server proxies `/api/*` to (apps/agent `dev:token`).
TOKEN_SERVER_URL=http://localhost:8787
# Vite dev server port.
WEB_PORT=5173
# Token endpoint the browser calls. Default goes through the Vite proxy above;
# set an absolute URL only if the page is served without that proxy.
# The character list is fetched from the sibling path (`/api/token` → `/api/characters`).
VITE_TOKEN_ENDPOINT=/api/token
