{
  "name": "@ptoy/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/agent.ts dev",
    "start": "tsx --env-file-if-exists=.env src/agent.ts start",
    "dev:token": "tsx watch --env-file-if-exists=.env src/token-server.ts",
    "start:token": "tsx --env-file-if-exists=.env src/token-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:call": "tsx --env-file-if-exists=.env scripts/sim-call.ts",
    "emotion:compliance": "tsx --env-file-if-exists=.env scripts/emotion-compliance.ts",
    "chat": "tsx --env-file-if-exists=.env scripts/chat.ts"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.3",
    "@livekit/agents-plugin-openai": "1.9.3",
    "@livekit/rtc-node": "^1.2.1",
    "livekit-server-sdk": "^2.19.2",
    "zod": "^4.6.7",
    "@ptoy/segmenter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  }
}
