{
  "name": "@ptoy/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-agent.mjs dev",
    "start": "node ../../scripts/run-agent.mjs start",
    "dev:token": "node ../../scripts/run-agent.mjs dev:token",
    "start:token": "node ../../scripts/run-agent.mjs start:token",
    "invite": "node ../../scripts/run-agent.mjs invite",
    "check:access-recovery": "tsx scripts/check-access-recovery.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:call": "node ../../scripts/run-agent.mjs sim:call",
    "emotion:compliance": "node ../../scripts/run-agent.mjs emotion:compliance",
    "chat": "node ../../scripts/run-agent.mjs chat",
    "check:characters": "node ../../scripts/run-agent.mjs check:characters",
    "check:ambience": "node ../../scripts/run-agent.mjs check:ambience"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.3",
    "@livekit/agents-plugin-openai": "1.9.3",
    "@livekit/rtc-node": "^1.2.1",
    "livekit-server-sdk": "^2.19.2",
    "zod": "^4.6.7",
    "@ptoy/segmenter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  }
}
