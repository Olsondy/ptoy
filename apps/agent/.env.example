# ---- LiveKit (used by both the agent worker and the token server) ----
# WebSocket URL the agent uses to reach LiveKit Server.
#   Mac dev against local server:   ws://localhost:7880
#   Mac dev against Windows host:   ws://192.168.31.82:7880
#   Agent deployed on Windows:      ws://127.0.0.1:7880
LIVEKIT_URL=ws://127.0.0.1:7880
# `livekit-server --dev` uses the fixed key/secret devkey / secret.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# `pnpm app` starts LiveKit from this binary unless something already listens on LIVEKIT_URL's port.
#   Windows: C:\livekit\livekit-server.exe
LIVEKIT_SERVER_BIN=
# IP LiveKit advertises to browsers; pin it on hosts with several network adapters (Hyper-V / WSL / VPN).
# LIVEKIT_NODE_IP=192.168.31.82

# ---- Agent worker ----
# Leave unset: an empty agent name means automatic dispatch (agent joins every new room).
# LIVEKIT_AGENT_NAME=
# Defaults to info (`llm reply` / `user utterance` / `turn timing` per turn); debug adds LiveKit's internals.
# LOG_LEVEL=debug

# ---- Token server (pnpm --filter @ptoy/agent dev:token) ----
# URL handed to the browser. Defaults to LIVEKIT_URL; set it when the browser
# reaches LiveKit at a different address than the agent (e.g. phone on the LAN).
# LIVEKIT_PUBLIC_URL=ws://192.168.31.82:7880
TOKEN_SERVER_HOST=0.0.0.0
TOKEN_SERVER_PORT=8787
# Allowed CORS origin. The web dev server proxies /api to this server, so '*' is only
# relevant when the browser calls the token server directly.
TOKEN_SERVER_CORS_ORIGIN=*
# Token lifetime (vercel/ms format, e.g. 10m, 1h).
TOKEN_TTL=1h
# Optional stable secret (at least 32 characters) for encrypted character links.
# Defaults to LIVEKIT_API_SECRET. Rotating the effective secret invalidates existing links.
# CHARACTER_LINK_SECRET=

# ---- Call pipeline ----
# conversation: VAD + STT → LLM → TTS, both subtitles (default).
# transcribe: VAD + STT → user subtitles only. echo: loop the caller's audio back (no models needed).
AGENT_PIPELINE=conversation

# ---- Listening pipeline (VAD + SenseVoice STT, see docs/architecture/server.md §11) ----
# SenseVoice ASR with an OpenAI-compatible POST /v1/audio/transcriptions. Mac dev against Windows host: http://192.168.31.82:8001
ASR_URL=http://127.0.0.1:8001
ASR_TIMEOUT_MS=5000
# Spoken language sent to SenseVoice (auto = detect; short Chinese can come back as Korean) and reported
# on transcripts (TURN_DETECTOR=eot picks its per-language threshold by it).
ASR_LANGUAGE=zh
# Turn-taking and interruption thresholds: reasons and measurements in docs/architecture/server.md §11.1.
# transcript: VAD silence ends the turn; a transcript that stops mid-sentence ("然后", "我觉得", "，")
#   waits ENDPOINTING_MAX_DELAY_MS for the rest (default). vad: always ENDPOINTING_MIN_DELAY_MS.
# eot: LiveKit's local audio end-of-turn model on top of VAD.
TURN_DETECTOR=transcript
VAD_MIN_SILENCE_MS=550
# Silence after the caller's last word before the turn ends (raise to ~1000 for slow speakers).
ENDPOINTING_MIN_DELAY_MS=800
# Silence waited when the turn looks unfinished (transcript / eot).
ENDPOINTING_MAX_DELAY_MS=2000
# Caller speech this long pauses the agent; a transcript then cuts it, otherwise it resumes.
INTERRUPTION_MIN_SPEECH_MS=150
# Silence after a pause with no transcript (cough, noise, "嗯") before the agent resumes.
FALSE_INTERRUPTION_TIMEOUT_MS=1000

# ---- Conversation: LLM (llama-server, OpenAI-compatible; see docs/architecture/server.md §5) ----
# Mac dev against Windows host: http://192.168.31.82:8080/v1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-8b
# llama-server ignores the key; any non-empty value works.
LLM_API_KEY=no-key
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.7
# Per-request timeout and retries before the caller sees `ptoy.agent_error`.
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRY=1
# Hosted reasoning models (none|minimal|low|medium|high). Unset = the lowest level the endpoint's
# /models lists for LLM_MODEL (magpie: DeepSeek → none, ChatGPT codex/* → low), or nothing sent when
# it lists none (llama-server). Set it only to override. Via magpie: LLM_BASE_URL=http://127.0.0.1:3425/v1.
# ChatGPT can't turn thinking off (first token ~1–1.5s at low); DeepSeek at none ~0.4–0.8s, and it
# thinks when nothing is sent (~2–3s, can use up LLM_MAX_TOKENS).
# LLM_REASONING_EFFORT=
# OpenRouter instead of llama-server (no local model):
#   LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...
#   LLM_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Check the model keeps the emotion tags first: pnpm --filter @ptoy/agent emotion:compliance
# Shared prompts/characters/_rules.md (call rules + emotion tags for IndexTTS2) and the caller's [用户语气:X].
# false: the persona alone is the system prompt (it must carry its own speaking rules) and replies come
#   untagged, e.g. with TTS_BACKEND=openrouter.
# LLM_SHARED_RULES=true
# Character prompts (Chinese): one <id>.md per character + shared _rules.md (ADR 0007).
# Read by the agent and the token server. Defaults to apps/agent/prompts/characters.
# CHARACTERS_DIR=
# Character a call gets when the page picked none (or picked one that no longer exists).
# DEFAULT_CHARACTER=xiaoyou

# ---- Conversation: TTS (IndexTTS2) ----
# gradio: WebUI /gen_single (stage 1). fastapi: services/tts (stage 2, replaces the WebUI; never run both).
# openrouter: OpenRouter speech API (Fish), no local GPU.
TTS_BACKEND=gradio
# -- gradio --
# Mac dev against Windows host: http://192.168.31.82:7860
TTS_GRADIO_URL=http://127.0.0.1:7860
# Speaker reference wav on this machine (required for gradio; not committed). Uploaded once per agent process.
TTS_REF_AUDIO=/path/to/ref.wav
TTS_LANGUAGE=ZH
# -- fastapi -- (reference audios, language and model settings are configured on the service, see services/tts/README.md).
# Each call asks for its character's `voice:` (ADR 0008); the gradio backend speaks every character with TTS_REF_AUDIO.
# Mac dev against Windows host: http://192.168.31.82:8002
TTS_FASTAPI_URL=http://127.0.0.1:8002
# -- openrouter --
# TTS_OPENROUTER_URL=https://openrouter.ai/api/v1
# TTS_OPENROUTER_API_KEY=sk-or-...
# TTS_OPENROUTER_MODEL=fish-audio/s2.1-pro
# Character `voice:` → Fish voice id, comma-separated; an unmapped voice speaks with the model default.
# TTS_OPENROUTER_VOICES=xiaoyou-default=<fish voice id>,zhixin=<fish voice id>
# The recorded fillers are IndexTTS voices: set FILLERS_ENABLED=false or regenerate them in the Fish voice.
# -- all --
# vector: each segment's emotion tag → IndexTTS2 one-hot emotion vector (平静 segments use the reference audio);
#   openrouter: a "[开心]" style hint before the text instead (no strength, TTS_EMO_WEIGHT unused).
# reference: emotion always follows the speaker reference audio. See docs/architecture/emotion-pipeline.md.
TTS_EMOTION_CONTROL=vector
# Emotion strength in vector mode (gradio emo_weight / fastapi emo_alpha, 0-1). 1.0 starts to slur words; 0.8 pulls the
# voice away from the reference; 0.5 loses sad/angry (docs/architecture/emotion-pipeline.md).
TTS_EMO_WEIGHT=0.6
# Whole request (queue + synthesis + download) per sentence.
TTS_TIMEOUT_MS=20000
# Agent audio track sample rate; TTS output (22.05 kHz) is resampled to it.
AGENT_AUDIO_SAMPLE_RATE=24000

# ---- Conversation: fillers (pre-recorded, see services/fillers and docs/architecture/server.md §12) ----
# Play a short filler ("嗯…" / "好的，" / "我明白") while a slow reply is still being generated.
FILLERS_ENABLED=true
# One <voice>/manifest.json per voice; a call plays its character voice's set, none if that voice has no set.
# Defaults to the repo's assets/fillers (48 kHz mono wavs, resampled to AGENT_AUDIO_SAMPLE_RATE).
# FILLERS_DIR=
# Not every turn gets a filler: plain acknowledgements play on half the turns, a group repeated
# from the turn before half as often (apps/agent/src/fillers/choice.ts). true = every turn (testing).
# FILLERS_ALWAYS=false
# The chosen filler waits this long after the turn ends and is skipped if the reply's first audio is
# ready by then, so only a slow reply gets one (a filler right at every turn end sounded like jumping in).
# 0 = play as soon as the turn ends.
FILLER_DELAY_MS=2000
