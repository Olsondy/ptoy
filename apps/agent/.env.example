# ptoy agent + token server configuration. Copy to apps/agent/.env (`pnpm app` and every
# @ptoy/agent script read it). Comments go on their own line, never after a value.
#
# Three ways to run the models; the active values below are profile A, the others are commented
# out in each section (search for "Profile B" / "Profile C"):
#   A. Local models (Windows GPU host): SenseVoice ASR :8001, llama-server :8080, IndexTTS :7860/:8002.
#   B. Cloud app, local models (ADR 0011): same as A, model URLs point at the Windows host over Tailscale.
#   C. All models on OpenRouter (ADR 0012): no model process anywhere, one OpenRouter key:
#        ASR_URL=https://openrouter.ai/api        ASR_API_KEY=sk-or-...   ASR_MODEL=qwen/qwen3-asr-1.7b
#        LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_API_KEY=sk-or-...  LLM_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
#        LLM_SHARED_RULES=false                   TTS_BACKEND=openrouter  TTS_OPENROUTER_API_KEY=sk-or-...
#        TTS_OPENROUTER_VOICES=rouyi=<fish voice id>  DEFAULT_CHARACTER=rouyi  FILLERS_ENABLED=false

# =====================================================================================
# 1. LiveKit (agent worker and token server)
# =====================================================================================
# WebSocket URL the agent uses to reach LiveKit Server.
#   Agent on the LiveKit host (Windows or cloud): ws://127.0.0.1:7880
#   Mac dev against the Windows host:              ws://192.168.31.82:7880
LIVEKIT_URL=ws://127.0.0.1:7880
# `livekit-server --dev` uses the fixed key/secret devkey / secret; use your server's pair otherwise.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# `pnpm app` starts LiveKit from this binary unless something already listens on LIVEKIT_URL's port.
#   Windows: C:\livekit\livekit-server.exe
LIVEKIT_SERVER_BIN=
# URL handed to the browser. Defaults to LIVEKIT_URL; set it when the browser reaches LiveKit at
# another address (phone on the LAN, Tailscale `wss://<host>.<tailnet>.ts.net:8443`, cloud RTC domain).
# LIVEKIT_PUBLIC_URL=ws://192.168.31.82:7880
# IP LiveKit advertises to browsers; pin it on hosts with several adapters (Hyper-V / WSL / VPN / Tailscale).
# With a Tailscale IP here every device must connect through Tailscale.
# LIVEKIT_NODE_IP=192.168.31.82

# =====================================================================================
# 2. Agent worker
# =====================================================================================
# conversation: VAD + ASR → LLM → TTS, both subtitles (default).
# transcribe: VAD + ASR → caller subtitles only. echo: loop the caller's audio back (no models needed).
AGENT_PIPELINE=conversation
# Leave unset: an empty agent name means automatic dispatch (the agent joins every new room).
# LIVEKIT_AGENT_NAME=
# Defaults to info (`llm reply` / `user utterance` / `turn timing` per turn); debug adds LiveKit's internals.
# LOG_LEVEL=debug
# SDK readiness endpoint (registered with LiveKit and inference process alive).
# AGENT_HEALTH_HOST=127.0.0.1
# AGENT_HEALTH_PORT=8081

# =====================================================================================
# 3. Web page, token server and invite access (ADR 0010)
# =====================================================================================
TOKEN_SERVER_HOST=0.0.0.0
TOKEN_SERVER_PORT=8787
# Port of the page `pnpm app` serves (vite preview); the dev server (`pnpm dev`) uses WEB_PORT, 5173.
# WEB_PREVIEW_PORT=4173
# The exact address the browser opens the page at (scheme + host + port). POSTs from any other
# origin are refused (403 invalid_origin) and the invite cookie is Secure when it is https.
# Only loopback may be plain http. One value only:
#   pnpm app on this machine:  http://localhost:4173
#   through Tailscale:         https://<host>.<tailnet>.ts.net
#   cloud (deploy/cloud sets it from APP_DOMAIN): https://<APP_DOMAIN>
APP_ORIGIN=http://localhost:4173
# Invites: pnpm --filter @ptoy/agent invite create "friend note" | list | revoke <id>
# Persistent SQLite file; keep it outside a disposable release folder.
INVITE_DB_PATH=.data/access.sqlite
# Agent → token server URL for call admission, never exposed to browsers.
ACCESS_INTERNAL_URL=http://127.0.0.1:8787
# Shared by both services, at least 32 characters; derived from LIVEKIT_API_SECRET when unset.
# ACCESS_INTERNAL_SECRET=
# Overrides the Secure cookie flag derived from APP_ORIGIN.
# ACCESS_COOKIE_SECURE=
# ACCESS_PENDING_TIMEOUT_MS=60000
# ACCESS_AGENT_TIMEOUT_MS=30000
# ACCESS_RECONCILE_MS=5000
# Exact addresses of your reverse proxy; empty ignores forwarded IP headers.
# ACCESS_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Only initializes the setting when absent; later maintenance changes persist in SQLite.
# ACCESS_MAINTENANCE_DEFAULT=false
# Browser access token lifetime (vercel/ms format, e.g. 2m, 1h).
TOKEN_TTL=2m
# Secret (at least 32 characters) for encrypted fixed-character links; defaults to LIVEKIT_API_SECRET.
# Rotating the effective secret invalidates existing links.
# CHARACTER_LINK_SECRET=

# =====================================================================================
# 4. Characters (ADR 0007)
# =====================================================================================
# One <id>.md per character + shared _rules.md; read by the agent and the token server.
# Defaults to apps/agent/prompts/characters.
# CHARACTERS_DIR=
# Character a call gets when the page picked none. Must be made for TTS_BACKEND (its `tts_backends`
# front matter, default gradio, fastapi), or the services refuse to start. Profile C: rouyi.
# DEFAULT_CHARACTER=xiaoyou

# =====================================================================================
# 5. Turn-taking and interruption (docs/architecture/server.md §11.1)
# =====================================================================================
# transcript: VAD silence ends the turn; a transcript that stops mid-sentence ("然后", "我觉得", "，")
#   waits ENDPOINTING_MAX_DELAY_MS for the rest (default). vad: always ENDPOINTING_MIN_DELAY_MS.
#   eot: LiveKit's local audio end-of-turn model on top of VAD.
TURN_DETECTOR=transcript
VAD_MIN_SILENCE_MS=550
# Silence after the caller's last word before the turn ends (raise to ~1000 for slow speakers).
ENDPOINTING_MIN_DELAY_MS=800
# Silence waited when the turn looks unfinished (transcript / eot).
ENDPOINTING_MAX_DELAY_MS=2000
# Caller speech this long pauses the agent; a transcript then cuts it, otherwise it resumes.
INTERRUPTION_MIN_SPEECH_MS=150
# Silence after a pause with no transcript (cough, noise, "嗯") before the agent resumes.
FALSE_INTERRUPTION_TIMEOUT_MS=1000

# =====================================================================================
# 6. ASR (speech → text)
# =====================================================================================
# Base URL of an OpenAI-compatible transcription API; the agent appends /v1/audio/transcriptions.
# Profile A: SenseVoice on this machine. Profile B / Mac dev: the Windows host, e.g. http://192.168.31.82:8001
ASR_URL=http://127.0.0.1:8001
# Profile C: OpenRouter. No SenseVoice emotion tags then (the caller's tone stays unknown) and each
# turn pays a cloud round trip. Other Chinese-capable models: openai/gpt-4o-transcribe, elevenlabs/scribe-v2.
# ASR_URL=https://openrouter.ai/api
# ASR_API_KEY=sk-or-...
# ASR_MODEL=qwen/qwen3-asr-1.7b
ASR_TIMEOUT_MS=5000
# Spoken language sent to the ASR (auto = detect; short Chinese can come back as Korean) and reported
# on transcripts (TURN_DETECTOR=eot picks its per-language threshold by it).
ASR_LANGUAGE=zh

# =====================================================================================
# 7. LLM (OpenAI-compatible chat completions, docs/architecture/server.md §5)
# =====================================================================================
# Profile A: llama-server. Profile B / Mac dev: the Windows host, e.g. http://192.168.31.82:8080/v1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-8b
# llama-server ignores the key; any non-empty value works.
LLM_API_KEY=no-key
# Profile C: OpenRouter (pair it with LLM_SHARED_RULES=false and a character carrying its own rules).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.7
# Per-request timeout and retries before the caller sees `ptoy.agent_error`.
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRY=1
# Hosted reasoning models (none|minimal|low|medium|high). Unset = the lowest level the endpoint's
# /models lists for LLM_MODEL (magpie: DeepSeek → none, ChatGPT codex/* → low), or nothing sent when
# it lists none (llama-server, OpenRouter). Set it only to override. Via magpie: LLM_BASE_URL=http://127.0.0.1:3425/v1.
# LLM_REASONING_EFFORT=
# Append the shared prompts/characters/_rules.md (call rules + emotion tags that drive IndexTTS2)
# to every persona, and prefix the answered caller line with [用户语气:X].
# false: the persona alone is the system prompt (it must carry its own speaking rules) and replies
#   come untagged. Check a new model keeps the tags first: pnpm --filter @ptoy/agent emotion:compliance
# LLM_SHARED_RULES=true

# =====================================================================================
# 8. TTS (text → speech)
# =====================================================================================
# gradio: IndexTTS WebUI /gen_single. fastapi: services/tts (replaces the WebUI; never run both).
# openrouter: OpenRouter speech API (Fish). The token server reads it too: the page only offers
# characters whose `tts_backends` include it.
TTS_BACKEND=gradio
# Whole request (queue + synthesis + download) per sentence.
TTS_TIMEOUT_MS=20000
# vector: each sentence's emotion tag drives the voice (IndexTTS2 emotion vector; openrouter: a
#   "[开心]" style hint, no strength). reference: emotion always follows the speaker reference.
# See docs/architecture/emotion-pipeline.md.
TTS_EMOTION_CONTROL=vector
# IndexTTS emotion strength in vector mode (0-1). 1.0 starts to slur words; 0.8 pulls the voice away
# from the reference; 0.5 loses sad/angry. Characters override it with `tts_emo_weight`.
TTS_EMO_WEIGHT=0.6
# Agent audio track sample rate; every backend's audio is resampled to it.
AGENT_AUDIO_SAMPLE_RATE=24000

# -- gradio (one voice for every character; per-character speed and pauses are ignored) --
# Mac dev against the Windows host: http://192.168.31.82:7860
TTS_GRADIO_URL=http://127.0.0.1:7860
# Speaker reference wav on this machine (required for gradio; not committed). Uploaded once per agent process.
TTS_REF_AUDIO=/path/to/ref.wav
TTS_LANGUAGE=ZH

# -- fastapi (each character's `voice:` picks a reference on the service, ADR 0008) --
# Reference audios, language and model settings live on the service (services/tts/README.md).
# Mac dev against the Windows host: http://192.168.31.82:8002
TTS_FASTAPI_URL=http://127.0.0.1:8002

# -- openrouter (Profile C) --
# TTS_OPENROUTER_URL=https://openrouter.ai/api/v1
# TTS_OPENROUTER_API_KEY=sk-or-...
# TTS_OPENROUTER_MODEL=fish-audio/s2.1-pro
# Character `voice:` → Fish voice id, comma-separated; an unmapped voice speaks with the model default.
# Characters add delivery hints with `tts_style` (e.g. rouyi: 亲密中文耳语，轻声性感).
# TTS_OPENROUTER_VOICES=rouyi=<fish voice id>

# =====================================================================================
# 9. Fillers (pre-recorded "嗯…" / "好的，" while a slow reply is generated, server.md §12)
# =====================================================================================
# The shipped sets are IndexTTS voices: turn them off with TTS_BACKEND=openrouter (or record Fish ones).
FILLERS_ENABLED=true
# One <voice>/manifest.json per voice; a call plays its character voice's set, none if that voice has no set.
# Defaults to the repo's assets/fillers (48 kHz mono wavs, resampled to AGENT_AUDIO_SAMPLE_RATE).
# FILLERS_DIR=
# Not every turn gets a filler: plain acknowledgements play on half the turns, a group repeated
# from the turn before half as often (apps/agent/src/fillers/choice.ts). true = every turn (testing).
# FILLERS_ALWAYS=false
# The chosen filler waits this long after the turn ends and is skipped if the reply's first audio is
# ready by then, so only a slow reply gets one. 0 = play as soon as the turn ends.
FILLER_DELAY_MS=2000

# =====================================================================================
# 10. Model readiness gate (cloud app, Profile B)
# =====================================================================================
# true: new calls are refused while a self-hosted model is down (invites and running calls are unaffected).
# Probes ASR_URL/health, LLM_BASE_URL without /v1 + /health and TTS_FASTAPI_URL/health; anything on
# openrouter.ai (and TTS_BACKEND=openrouter) is skipped, so Profile C has nothing to probe.
# CLOUD_MODEL_CHECKS=false
# CLOUD_MODEL_CHECK_TIMEOUT_MS=2000
# CLOUD_MODEL_CHECK_CACHE_MS=3000
